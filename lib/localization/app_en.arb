  "tourWelcomeTitle": "Welcome to NuCatch!",
  "@tourWelcomeTitle": {
    "description": "Title for the welcome tour step"
  },
  "tourWelcomeDesc": "Welcome! This quick tour will help you get started smoothly with **NuCatch**. We'll show you all the **main features** so you can dive right in and start playing. Let's begin!",
  "@tourWelcomeDesc": {
    "description": "Description for the welcome tour step"
  },
  "tourStartTitle": "Start - Begin Your Game",
  "@tourStartTitle": {
    "description": "Title for the start button tour step"
  },
  "tourStartDesc": "Tap the **Start button** to begin. You'll then choose between **Solo Mode** for single-player mathematical challenges, or **Combat Mode** for real-time **Bluetooth** multiplayer battles. Let's explore both options!",
  "@tourStartDesc": {
    "description": "Description for the start button tour step"
  },
  "tourInstantStartTitle": "Instant Start - Quick Play",
  "@tourInstantStartTitle": {
    "description": "Title for the instant start button tour step"
  },
  "tourInstantStartDesc": "Want to jump right in? Tap the **Instant Start button** to begin a solo game immediately with the same difficulty level you played last time. It's the fastest way to continue your progress!",
  "@tourInstantStartDesc": {
    "description": "Description for the instant start button tour step"
  },
  "tourSoloTitle": "Solo Mode - Play Alone",
  "@tourSoloTitle": {
    "description": "Title for solo mode tour step"
  },
  "tourSoloDesc": "In **Solo Mode**, challenge yourself with mathematical equations! Choose from **4 difficulty levels** (Easy to Extremely Hard). You start with **3 lives** - each wrong answer or timeout costs 1 life. **Higher difficulty** means more points! Now let's look at the multiplayer option.",
  "@tourSoloDesc": {
    "description": "Description for solo mode tour step"
  },
  "tourCombatTitle": "Combat Mode - Bluetooth Multiplayer",
  "@tourCombatTitle": {
    "description": "Title for combat mode tour step"
  },
  "tourCombatDesc": "**Combat Mode** lets you battle a friend via **Bluetooth**! **Two players** take turns solving equations - **no WiFi needed**, just stay within **10 meters**. The host plays first initially, but in rematches the loser goes first. You have two ways to start a match:",
  "@tourCombatDesc": {
    "description": "Description for combat mode tour step"
  },
  "tourCreateRoomTitle": "Combat Mode → Create Room",
  "@tourCreateRoomTitle": {
    "description": "Title for create room tour step"
  },
  "tourCreateRoomDesc": "First option: **Create Room** makes you the **host**! After granting **Bluetooth permissions**, you'll wait for a guest to join your room, then choose the **difficulty level**. As host, you **play first** in the initial match. Or you can join someone else's game:",
  "@tourCreateRoomDesc": {
    "description": "Description for create room tour step"
  },
  "tourJoinRoomTitle": "Combat Mode → Join Room",
  "@tourJoinRoomTitle": {
    "description": "Title for join room tour step"
  },
  "tourJoinRoomDesc": "Second option: **Join Room** makes you the **guest**! After granting permissions, you'll **scan** for nearby rooms, select one, and tap **ready**. The host chooses difficulty, and you'll **play second** in the initial match. Now let's check the other menu features.",
  "@tourJoinRoomDesc": {
    "description": "Description for join room tour step"
  },
  "tourLeaderboardTitle": "Top Score - Leaderboards",
  "@tourLeaderboardTitle": {
    "description": "Title for leaderboard tour step"
  },
  "tourLeaderboardDesc": "Track your progress here! View **global rankings**, your **personal records**, and **statistics** including games played, win rate, accuracy, and scores by difficulty level. Compare with friends and see how you improve over time. Finally, let's visit Settings.",
  "@tourLeaderboardDesc": {
    "description": "Description for leaderboard tour step"
  },
  "tourSettingsTitle": "Settings - Customize",
  "@tourSettingsTitle": {
    "description": "Title for settings tour step"
  },
  "tourSettingsDesc": "Customize everything here! Change your **username**, select a **theme**, adjust **sound/music**, choose your **language**, and manage **privacy settings**. You can restart this tour anytime from here. That's it - you're ready to play!",
