# ════════════════════════════════════════════════════════════════════════════
# Fastlane store-deployment settings — template.
#
#   cp .env.fastlane.example .env.fastlane     # then fill in the real values
#
# .env.fastlane is git-ignored and read only by the Fastfiles
# (tool/release/fastlane_common.rb). Keep these OUT of `.env`: that file is
# bundled into the app as an asset, so anything in it ships inside the APK/IPA.
#
# Relative paths resolve from the repo root. Values already set in the real
# environment (CI secrets) take precedence over this file.
# How to create each key: docs/DEPLOYMENT.md §4.
# Check your setup without uploading anything:
#   (cd android && bundle exec fastlane check_env)
#   (cd ios     && bundle exec fastlane check_env)
# ════════════════════════════════════════════════════════════════════════════

# ── Google Play (android: deploy_staging / deploy_production / upload_screenshots) ──
# Service-account JSON with the Release Manager role (Play Console → Users and
# permissions). The file itself is git-ignored.
SUPPLY_JSON_KEY=android/play-store-service-account.json

# ── App Store Connect API key (ios: deploy_staging / deploy_production / upload_screenshots) ──
# App Store Connect → Users and Access → Integrations → App Store Connect API
# (role: App Manager). Key ID and Issuer ID are shown on that page.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# The .p8 downloaded once from that page (ios/private_keys/ is git-ignored)…
ASC_KEY_FILEPATH=ios/private_keys/AuthKey_XXXXXXXXXX.p8
# …or, on CI, its contents (raw or base64) instead of a file path:
# ASC_KEY_CONTENT=

# ── iOS release signing (manual, App Store profile — matches the Xcode Release
#    config and the CI workflow). These defaults are this app's; change only if
#    the team or profile changes. The profile must be installed on the Mac.
APPLE_TEAM_ID=R23LP5MFKD
IOS_PROVISIONING_PROFILE=NuCatch_AppStore

# ── Firebase App Distribution (fastlane <platform> distribute) ──
# Create with `firebase login:ci`.
FIREBASE_CLI_TOKEN=

# Android release signing isn't configured here: Gradle reads
# android/key.properties (git-ignored) and the keystore it names.
