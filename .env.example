# Environment Configuration File

# Firebase Project (for FlutterFire configuration)
FIREBASE_PROJECT_ID=your_firebase_project_id

# App URLs and Contact
PROFILE_URL=https://nucatch.net
PRIVACY_POLICY_URL=https://nucatch.net/#policy
FACEBOOK_URL=https://www.facebook.com/nuCatch/
EMAIL_CONTACT=mtuan.0111@gmail.com

# App Store Configuration (for FlutterFire)
ANDROID_PACKAGE_NAME=your_android_package_name
IOS_BUNDLE_ID=your_ios_bundle_id
IOS_APP_ID=your_ios_app_id

# ════════════════════════════════════════════════════════════════════════════
# Fastlane deployment secrets — see docs/DEPLOYMENT.md for how to generate each.
# Copy this file to .env and fill in real values. NEVER commit the real .env.
# ════════════════════════════════════════════════════════════════════════════

# ── Firebase App Distribution (fastlane <platform> distribute) ──
# Generate: `firebase login:ci`  (docs/DEPLOYMENT.md §Firebase)
FIREBASE_CLI_TOKEN=your_firebase_cli_token

# ── Google Play (Android: deploy_staging / deploy_production / upload_screenshots) ──
# Path to the Google Play service-account JSON (Play Console → API access).
SUPPLY_JSON_KEY=./android/play-store-service-account.json

# ── App Store Connect API key (iOS: deploy_staging / deploy_production / upload_screenshots) ──
# App Store Connect → Users and Access → Integrations → App Store Connect API.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ASC_KEY_FILEPATH=./ios/private_keys/AuthKey_XXXXXXXXXX.p8